# TRINETRA Backend Environment Variables

# Groq Cloud API Key (Required for Llama-3.3-70B Reasoning Core)
GROQ_API_KEY=your_groq_api_key_here

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Dynamic Port Binding (Railway/Render automatically injects $PORT)
PORT=8000
